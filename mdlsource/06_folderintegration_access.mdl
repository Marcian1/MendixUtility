mdl 1;

CREATE OR MODIFY MODULE ROLE FolderIntegration.User DESCRIPTION 'Can use the folder integration page';

GRANT CREATE, DELETE, READ *, WRITE * ON ENTITY FolderIntegration.FolderJob TO FolderIntegration.User;
GRANT CREATE, DELETE, READ *, WRITE * ON ENTITY FolderIntegration.FolderNode TO FolderIntegration.User;
GRANT CREATE, DELETE, READ *, WRITE * ON ENTITY FolderIntegration.RestResponse TO FolderIntegration.User;

GRANT VIEW ON PAGE FolderIntegration.FolderIntegration_Home TO FolderIntegration.User;
GRANT VIEW ON PAGE FolderIntegration.CreateFolders_Popup TO FolderIntegration.User;

GRANT EXECUTE ON MICROFLOW FolderIntegration.DS_GetJob TO FolderIntegration.User;
GRANT EXECUTE ON MICROFLOW FolderIntegration.ACT_Job_Reset TO FolderIntegration.User;
GRANT EXECUTE ON MICROFLOW FolderIntegration.ACT_Job_SaveSettings TO FolderIntegration.User;
GRANT EXECUTE ON MICROFLOW FolderIntegration.ACT_Job_Start TO FolderIntegration.User;
GRANT EXECUTE ON MICROFLOW FolderIntegration.ACT_Job_Sync TO FolderIntegration.User;
GRANT EXECUTE ON NANOFLOW FolderIntegration.NAN_OpenPopup TO FolderIntegration.User;
GRANT EXECUTE ON NANOFLOW FolderIntegration.NAN_StartJob TO FolderIntegration.User;
GRANT EXECUTE ON NANOFLOW FolderIntegration.NAN_WatchJob TO FolderIntegration.User;

ALTER USER ROLE User ADD MODULE ROLES (FolderIntegration.User);
ALTER USER ROLE Administrator ADD MODULE ROLES (FolderIntegration.User);

CREATE OR MODIFY NAVIGATION Responsive
  HOME PAGE FolderIntegration.FolderIntegration_Home
{
  MENU ITEM 'Home' ( OnClick: SHOW PAGE MyFirstModule.Home_Web, Icon: GLYPH 57377 )
  MENU ITEM 'Folder integration' ( OnClick: SHOW PAGE FolderIntegration.FolderIntegration_Home )
};
