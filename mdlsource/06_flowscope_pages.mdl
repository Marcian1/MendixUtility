mdl 1;

-- Page state: open or close a row. The change is never committed, so nothing is written to the database.
CREATE OR MODIFY NANOFLOW FlowScope.NAN_ToggleExpanded ($Execution: FlowScope.Execution)
BEGIN
  CHANGE $Execution (IsExpanded = not($Execution/IsExpanded));
END;

/** Returns the single Settings object, creating it with its defaults the first time. */
CREATE OR MODIFY MICROFLOW FlowScope.SUB_GetSettings ()
RETURNS FlowScope.Settings AS $Result
BEGIN
  RETRIEVE $Existing FROM FlowScope.Settings FIRST;
  IF $Existing != empty THEN
    RETURN $Existing;
  END IF;
  $Created = CREATE FlowScope.Settings (CaptureEnabled = false, ThresholdMs = 1000, RetentionDays = 14);
  COMMIT $Created;
  RETURN $Created;
END;

CREATE OR MODIFY MICROFLOW FlowScope.ACT_OpenSettings ()
BEGIN
  $Settings = CALL MICROFLOW FlowScope.SUB_GetSettings();
  SHOW PAGE FlowScope.Settings_Popup (Settings = $Settings);
END;

/** The settings object for the status bar. Read only; SUB_GetSettings is the one that creates it. */
CREATE OR MODIFY MICROFLOW FlowScope.DS_Settings ()
RETURNS FlowScope.Settings AS $Settings
BEGIN
  RETRIEVE $Found FROM FlowScope.Settings FIRST;
  RETURN $Found;
END;

/** Switches capture on. Committing runs the after-commit event, which applies it at once. */
CREATE OR MODIFY MICROFLOW FlowScope.SUB_EnableCapture ($Settings: FlowScope.Settings)
BEGIN
  CHANGE $Settings (CaptureEnabled = true);
  COMMIT $Settings REFRESH;
END;

/** The status bar's "Turn on capture" button. */
CREATE OR MODIFY MICROFLOW FlowScope.ACT_EnableCapture ($Settings: FlowScope.Settings)
BEGIN
  CALL MICROFLOW FlowScope.SUB_EnableCapture(Settings = $Settings);
END;

CREATE OR MODIFY MICROFLOW FlowScope.ACT_DeleteAllExecutions ()
BEGIN
  RETRIEVE $All FROM FlowScope.Execution;
  DELETE $All;
END;

/** The full statement, as a read-only text. */
CREATE OR MODIFY PAGE FlowScope.Query_Popup (
  Params: ($Query: FlowScope.ExecutionQuery),
  Title: 'Query',
  Layout: Atlas_Core.PopupLayout,
  PopupWidth: 760,
  PopupHeight: 520
) {
  layoutgrid lgQ { row { column (DesktopWidth: 12) {
  dataview dvQuery (DataSource: $Query) {
    container ctnStats (Class: 'fs-facts') {
      container ctnRuns (Class: 'fs-fact') {
        dynamictext lblRuns (Content: 'Times run', Class: 'fs-label')
        dynamictext valRuns (Content: '{1}', ContentParams: ({1} = RunCount), Class: 'fs-value')
      }
      container ctnAvg (Class: 'fs-fact') {
        dynamictext lblAvg (Content: 'Average per run', Class: 'fs-label')
        dynamictext valAvg (Content: '{1} ms', ContentParams: ({1} = AvgMs format (decimalPrecision: 1)), Class: 'fs-value')
      }
      container ctnTotal (Class: 'fs-fact') {
        dynamictext lblTotal (Content: 'Total', Class: 'fs-label')
        dynamictext valTotal (Content: '{1} s', ContentParams: ({1} = TotalSeconds format (decimalPrecision: 2)), Class: 'fs-value')
      }
    }
    container ctnSql (Class: 'fs-sql') {
      textarea txtStatement (Label: 'Statement', Attribute: Statement, Editable: Never)
    }
    dynamictext txtNote (Content: 'Values are replaced by ? before saving, so no data is stored.', Class: 'fs-hint')
    container ctnFoot {
      actionbutton btnClose (Caption: 'Close', Action: close page, ButtonStyle: primary)
    }
  }
  } } }
};

CREATE OR MODIFY PAGE FlowScope.Settings_Popup (
  Params: ($Settings: FlowScope.Settings),
  Title: 'Capture settings',
  Layout: Atlas_Core.PopupLayout,
  PopupWidth: 560,
  PopupHeight: 560
) {
  layoutgrid lgS { row { column (DesktopWidth: 12) {
  dataview dvSettings (DataSource: $Settings) {
    checkbox cbCapture (Label: 'Capture enabled', Attribute: CaptureEnabled)
    textbox txtThreshold (Label: 'Only capture flows slower than (ms)', Attribute: ThresholdMs)
    dynamictext hintThreshold (Content: 'Faster runs are timed in memory and thrown away. Nothing is saved for them.', Class: 'fs-hint')
    textbox txtRetention (Label: 'Keep data for (days)', Attribute: RetentionDays)
    dynamictext hintRetention (Content: 'Older runs are deleted every night.', Class: 'fs-hint')
    textbox txtInclude (Label: 'Only profile microflows matching (regular expression)', Attribute: IncludeRegexp)
    textbox txtExclude (Label: 'Never profile microflows matching (regular expression)', Attribute: ExcludeRegexp)
    container ctnFoot {
      actionbutton btnDeleteAll (Caption: 'Delete all captured runs', Action: call microflow FlowScope.ACT_DeleteAllExecutions, ButtonStyle: danger)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes)
      actionbutton btnSave (Caption: 'Save', Action: save changes close page, ButtonStyle: primary)
    }
  }
  } } }
};

CREATE OR MODIFY PAGE FlowScope.Executions (
  Title: 'Microflow executions',
  Layout: Atlas_Core.Atlas_Default,
  Url: 'flowscope'
) {
  layoutgrid lgMain {
    row {
      column (DesktopWidth: 12) {
        dynamictext txtTitle (Content: 'Microflow executions', RenderMode: H2)
        dynamictext txtSub (Content: 'Slow microflow runs, captured automatically. Click a run to see where the time went.', Class: 'fs-sub')
        dataview dvStatus (DataSource: MICROFLOW FlowScope.DS_Settings) {
          container ctnOff (Class: 'fs-banner fs-banner--off', Visible: not($currentObject/CaptureEnabled)) {
            dynamictext txtOff (Content: 'Capture is off, so nothing is being recorded. Turn it on, then run a flow.')
            actionbutton btnTurnOn (
              Caption: 'Turn on capture',
              Action: call microflow FlowScope.ACT_EnableCapture(Settings = $currentObject),
              ButtonStyle: primary
            )
          }
          container ctnOn (Class: 'fs-banner', Visible: $currentObject/CaptureEnabled) {
            dynamictext txtOn (
              Content: 'Capturing microflows slower than {1} ms, keeping {2} days. A run shows up a moment after it finishes: press refresh in the search bar.',
              ContentParams: ({1} = ThresholdMs, {2} = RetentionDays)
            )
          }
        }
        container ctnCard (Class: 'fs-card') {
          container ctnBar (Class: 'fs-toolbar') {
            actionbutton btnSettings (Caption: 'Settings', Action: call microflow FlowScope.ACT_OpenSettings)
            actionbutton btnSample (Caption: 'Run sample flow', Action: call microflow FlowScope.SAMPLE_RunFlow)
          }
          container ctnColHead (Class: 'fs-cols fs-colhead') {
            dynamictext hCaret (Content: ' ')
            dynamictext hStarted (Content: 'Started')
            dynamictext hName (Content: 'Microflow')
            dynamictext hDur (Content: 'Duration (s)', Class: 'fs-num')
            dynamictext hSel (Content: 'Selects', Class: 'fs-num')
            dynamictext hUpd (Content: 'Updates', Class: 'fs-num')
            dynamictext hSub (Content: 'Sub-flows', Class: 'fs-num')
            dynamictext hHeap (Content: 'Heap Δ (MB)', Class: 'fs-num')
          }
          listview galExec (
            DataSource: DATABASE FlowScope.Execution SORT BY DurationSeconds DESC SEARCH BY MicroflowName,
            Class: 'fs-gallery'
          ) {
              container ctnItem (
                Class: 'fs-item',
                DynamicClasses: if $currentObject/IsExpanded then 'fs-open' else ''
              ) {
                container ctnHead (
                  Class: 'fs-cols fs-head',
                  OnClick: call nanoflow FlowScope.NAN_ToggleExpanded(Execution = $currentObject)
                ) {
                  dynamictext txtCaret (Content: '▶', Class: 'fs-caret')
                  dynamictext txtStarted (Content: '{1}', ContentParams: ({1} = StartedAt format (dateFormat: DateTime)))
                  dynamictext txtName (Content: '{1}', ContentParams: ({1} = MicroflowName), Class: 'fs-mono')
                  container ctnDur (Class: 'fs-num') {
                    dynamictext txtDur (
                      Content: '{1}',
                      ContentParams: ({1} = DurationSeconds format (decimalPrecision: 2)),
                      Class: 'fs-badge',
                      DynamicClasses: if $currentObject/DurationSeconds > 5 then 'fs-badge--slow' else if $currentObject/DurationSeconds > 1 then 'fs-badge--warn' else ''
                    )
                  }
                  dynamictext txtSel (Content: '{1}', ContentParams: ({1} = SelectCount), Class: 'fs-num')
                  dynamictext txtUpd (Content: '{1}', ContentParams: ({1} = UpdateCount), Class: 'fs-num')
                  dynamictext txtSub2 (Content: '{1}', ContentParams: ({1} = SubflowCount), Class: 'fs-num')
                  dynamictext txtHeap (Content: '{1}', ContentParams: ({1} = HeapDeltaMB), Class: 'fs-num fs-muted')
                }
                container ctnBody (Class: 'fs-body', Visible: $currentObject/IsExpanded) {
                  container ctnFacts (Class: 'fs-facts') {
                    container ctnF1 (Class: 'fs-fact') {
                      dynamictext lF1 (Content: 'Heap start to end', Class: 'fs-label')
                      dynamictext vF1 (Content: '{1} to {2} MB', ContentParams: ({1} = HeapStartMB, {2} = HeapEndMB), Class: 'fs-value')
                    }
                    container ctnF2 (Class: 'fs-fact') {
                      dynamictext lF2 (Content: 'Execution id', Class: 'fs-label')
                      dynamictext vF2 (Content: '{1}', ContentParams: ({1} = ExecutionId), Class: 'fs-value fs-mono')
                    }
                    container ctnF3 (Class: 'fs-fact') {
                      dynamictext lF3 (Content: 'Server node', Class: 'fs-label')
                      dynamictext vF3 (Content: '{1}', ContentParams: ({1} = NodeName), Class: 'fs-value')
                    }
                  }
                  tabcontainer tabsDetail {
                    tabpage tpSteps (Caption: 'Breakdown') {
                      container ctnSteps (Class: 'fs-steps') {
                        container ctnStepHead (Class: 'fs-step fs-step--head') {
                          dynamictext shName (Content: 'Step')
                          dynamictext shSel (Content: 'Selects', Class: 'fs-num')
                          dynamictext shUpd (Content: 'Updates', Class: 'fs-num')
                          dynamictext shTook (Content: 'Took (s)', Class: 'fs-num')
                          dynamictext shShare (Content: 'Share of run')
                        }
                        listview lvSteps (DataSource: DATABASE FROM $currentObject/FlowScope.ExecutionStep_Execution/FlowScope.ExecutionStep SORT BY Seq ASC, PageSize: 500) {
                          container ctnStep (
                            Class: 'fs-step',
                            DynamicClasses: if $currentObject/Kind = FlowScope.StepKind.Microflow then 'fs-step--mf' else ''
                          ) {
                            dynamictext txtStepName (
                              Content: '{1}',
                              ContentParams: ({1} = Name),
                              DynamicClasses: 'fs-depth-' + toString($currentObject/Depth)
                            )
                            dynamictext txtStepSel (Content: '{1}', ContentParams: ({1} = SelectCount), Class: 'fs-num')
                            dynamictext txtStepUpd (Content: '{1}', ContentParams: ({1} = UpdateCount), Class: 'fs-num')
                            dynamictext txtStepTook (Content: '{1}', ContentParams: ({1} = DurationSeconds format (decimalPrecision: 2)), Class: 'fs-num')
                            container ctnShare (DynamicClasses: if $currentObject/SharePercent > 30 and $currentObject/Depth > 0 then 'fs-hot' else '') {
                              pluggablewidget 'com.mendix.widget.custom.progressbar.ProgressBar' pbShare (
                                type: expression,
                                expressionCurrentValue: $currentObject/SharePercent,
                                expressionMinValue: 0,
                                expressionMaxValue: 100
                              )
                            }
                          }
                        }
                      }
                    }
                    tabpage tpQueries (Caption: 'Queries') {
                      container ctnQueries (Class: 'fs-steps') {
                        container ctnQueryHead (Class: 'fs-query fs-query--head') {
                          dynamictext qhRuns (Content: 'Runs', Class: 'fs-num')
                          dynamictext qhAvg (Content: 'Avg (ms)', Class: 'fs-num')
                          dynamictext qhTotal (Content: 'Total (s)', Class: 'fs-num')
                          dynamictext qhSql (Content: 'Statement - click to open in full')
                        }
                        listview lvQueries (DataSource: DATABASE FROM $currentObject/FlowScope.ExecutionQuery_Execution/FlowScope.ExecutionQuery SORT BY TotalSeconds DESC, PageSize: 200) {
                          container ctnQuery (
                            Class: 'fs-query',
                            OnClick: show page FlowScope.Query_Popup(Query = $currentObject)
                          ) {
                            dynamictext txtQRuns (Content: '{1}×', ContentParams: ({1} = RunCount), Class: 'fs-num')
                            dynamictext txtQAvg (Content: '{1}', ContentParams: ({1} = AvgMs format (decimalPrecision: 1)), Class: 'fs-num')
                            dynamictext txtQTotal (Content: '{1}', ContentParams: ({1} = TotalSeconds format (decimalPrecision: 2)), Class: 'fs-num')
                            dynamictext txtQSql (Content: '{1}', ContentParams: ({1} = Statement), Class: 'fs-mono')
                          }
                        }
                      }
                    }
                  }
                }
              }
          }
        }
      }
    }
  }
};

GRANT VIEW ON PAGE FlowScope.Executions TO FlowScope.Developer;
GRANT VIEW ON PAGE FlowScope.Settings_Popup TO FlowScope.Developer;
GRANT VIEW ON PAGE FlowScope.Query_Popup TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.SUB_GetSettings TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.ACT_OpenSettings TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.ACT_DeleteAllExecutions TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.DS_Settings TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.ACT_EnableCapture TO FlowScope.Developer;
GRANT EXECUTE ON MICROFLOW FlowScope.SAMPLE_RunFlow TO FlowScope.Developer;
GRANT EXECUTE ON NANOFLOW FlowScope.NAN_ToggleExpanded TO FlowScope.Developer;

