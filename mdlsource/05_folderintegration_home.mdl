mdl 1;

CREATE PAGE FolderIntegration.FolderIntegration_Home (
  Title: 'Folder integration',
  Layout: MyFirstModule.App_Default,
  Url: 'folder-integration'
) {
  layoutgrid lgMain (Width: FixedWidth) {
    row {
      column (DesktopWidth: 12) {
        dataview dvJob (DataSource: microflow FolderIntegration.DS_GetJob) {
          dynamictext txtBreadcrumb (Content: 'Documents / Contracts', Class: 'fi-breadcrumb')
          dynamictext txtTitle (Content: 'Contract documents', RenderMode: H1)

          container ctnCard (Class: 'fi-card') {
            container ctnCardHead (Class: 'fi-card-head') {
              container ctnCardTitle {
                dynamictext txtCardTitle (Content: 'Content Server folder structure', RenderMode: H3)
                dynamictext txtCardIntro (Content: 'Create the folder tree for this supplier in OpenText Content Server.', Class: 'fi-muted')
              }
              container ctnCardActions (Class: 'fi-card-actions') {
                dynamictext txtChip (
                  Content: '{1}',
                  ContentParams: ({1} = StatusChip),
                  Class: 'fi-chip',
                  DynamicClasses: 'fi-chip--' + toString($currentObject/Status)
                )
                actionbutton btnCreate (
                  Caption: 'Create folders',
                  Action: call nanoflow FolderIntegration.NAN_OpenPopup(Job = $currentObject),
                  ButtonStyle: primary,
                  Visible: $currentObject/Status = FolderIntegration.JobStatus.Ready
                )
                actionbutton btnProgress (
                  Caption: 'View progress',
                  Action: call nanoflow FolderIntegration.NAN_OpenPopup(Job = $currentObject),
                  ButtonStyle: primary,
                  Visible: $currentObject/Status = FolderIntegration.JobStatus.Running
                )
                actionbutton btnError (
                  Caption: 'View error',
                  Action: call nanoflow FolderIntegration.NAN_OpenPopup(Job = $currentObject),
                  ButtonStyle: primary,
                  Visible: $currentObject/Status = FolderIntegration.JobStatus.Failed
                )
                actionbutton btnResult (
                  Caption: 'View result',
                  Action: call nanoflow FolderIntegration.NAN_OpenPopup(Job = $currentObject),
                  ButtonStyle: primary,
                  Visible: $currentObject/Status = FolderIntegration.JobStatus.Done
                )
              }
            }
            container ctnFacts (Class: 'fi-facts') {
              container ctnFactRoot {
                dynamictext txtRootLabel (Content: 'Root folder', Class: 'fi-muted')
                dynamictext txtRootValue (Content: '{1}', ContentParams: ({1} = RootFolder))
              }
              container ctnFactStructure {
                dynamictext txtStructureLabel (Content: 'Structure', Class: 'fi-muted')
                dynamictext txtStructureValue (Content: '{1}', ContentParams: ({1} = StructureSummary))
              }
              container ctnFactTarget {
                dynamictext txtTargetLabel (Content: 'Target', Class: 'fi-muted')
                dynamictext txtTargetValue (Content: 'Content Server / Suppliers / Contracts')
              }
            }
          }

          container ctnProto (Class: 'fi-proto') {
            dynamictext txtProtoTitle (Content: 'Prototype controls (not part of the integration)', Class: 'fi-proto-title')
            container ctnProtoRow (Class: 'fi-proto-row') {
              combobox cmbScenario (
                Label: 'Scenario',
                Attribute: Scenario,
                Editable: $currentObject/Status != FolderIntegration.JobStatus.Running,
                OnChange: call microflow FolderIntegration.ACT_Job_Reset(Job = $currentObject)
              )
              combobox cmbSpeed (
                Label: 'Speed',
                Attribute: Speed,
                Editable: $currentObject/Status != FolderIntegration.JobStatus.Running,
                OnChange: call microflow FolderIntegration.ACT_Job_SaveSettings(Job = $currentObject)
              )
              actionbutton btnReset (
                Caption: 'Reset',
                Action: call microflow FolderIntegration.ACT_Job_Reset(Job = $currentObject),
                Visible: $currentObject/Status != FolderIntegration.JobStatus.Running
              )
            }
            dynamictext txtProtoHint (
              Content: 'Scenario and speed steer the placeholder REST flows. Changing the scenario resets the demo data; controls are locked while a job runs.',
              Class: 'fi-muted'
            )
          }
        }
      }
    }
  }
};
