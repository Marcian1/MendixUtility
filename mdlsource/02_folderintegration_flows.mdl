mdl 1;

ALTER ENTITY FolderIntegration.FolderJob ADD ATTRIBUTE IF NOT EXISTS BannerHeadline: String(200);
ALTER ENTITY FolderIntegration.FolderJob ADD ATTRIBUTE IF NOT EXISTS FailureReason: String(500);

/** Runs one folder-creation job at a time, in the background. */
CREATE TASK QUEUE FolderIntegration.FolderJobQueue (
  Parallelism: 1
);

/** Stands in for the network latency of a REST call, so the pop-up has something to show. */
CREATE JAVA ACTION FolderIntegration.JA_SimulateLatency(
  Milliseconds: Integer NOT NULL
) RETURNS Boolean
AS $$
try {
	Thread.sleep(Math.max(0L, Milliseconds));
} catch (InterruptedException e) {
	Thread.currentThread().interrupt();
}
return true;
$$;

/** Client-side wait used by the nanoflow that polls a running job. */
CREATE JAVASCRIPT ACTION FolderIntegration.JSA_Wait(
  Milliseconds: Integer NOT NULL
) RETURNS Boolean
AS $$
return new Promise(function (resolve) {
	setTimeout(function () { resolve(true); }, milliseconds);
});
$$;

-- ---------------------------------------------------------------------------
-- Placeholder REST calls. They only mimic what the real Content Server calls
-- would return; replace the body of each with a REST call activity later.
-- ---------------------------------------------------------------------------

/** PLACEHOLDER for the REST call that checks the names of one parent folder's children. No request is made. */
CREATE MICROFLOW FolderIntegration.REST_ValidateNames (
  $Job: FolderIntegration.FolderJob,
  $Node: FolderIntegration.FolderNode
)
RETURNS FolderIntegration.RestResponse AS $Response
FOLDER 'REST placeholders'
BEGIN
  LOG INFO NODE 'FolderIntegration' 'PLACEHOLDER GET /api/v2/nodes/validate for {1}' WITH ({1} = $Node/FullPath);
  $Response = CREATE FolderIntegration.RestResponse (
    Method = 'GET',
    Endpoint = '/api/v2/nodes/validate',
    StatusCode = 200,
    IsSuccess = true,
    Message = 'Names are valid'
  );
  RETURN $Response;
END;

/** PLACEHOLDER for the REST call that creates one folder. No request is made; the outcome follows the prototype scenario on the job. */
CREATE MICROFLOW FolderIntegration.REST_CreateFolder (
  $Job: FolderIntegration.FolderJob,
  $Node: FolderIntegration.FolderNode
)
RETURNS FolderIntegration.RestResponse AS $Response
FOLDER 'REST placeholders'
BEGIN
  DECLARE $Code Integer = 201;
  DECLARE $Message String = 'Folder created';
  IF $Job/Scenario = FolderIntegration.Scenario.TopFoldersExist AND $Node/Sequence <= 2 AND $Job/FixedAfterRetry = false THEN
    SET $Code = 409;
    SET $Message = 'Folder already exists';
  ELSIF $Job/Scenario = FolderIntegration.Scenario.FailAtQ4 AND $Node/SimulateFailure AND $Job/FixedAfterRetry = false THEN
    SET $Code = 500;
    SET $Message = 'An item with that name already exists.';
  END IF;
  LOG INFO NODE 'FolderIntegration' 'PLACEHOLDER POST /api/v2/nodes (folder {1}) returns {2}' WITH ({1} = $Node/FullPath, {2} = toString($Code));
  $Response = CREATE FolderIntegration.RestResponse (
    Method = 'POST',
    Endpoint = '/api/v2/nodes',
    StatusCode = $Code,
    IsSuccess = $Code < 400,
    Message = $Message
  );
  RETURN $Response;
END;

/** PLACEHOLDER for the REST call that uploads one file. No request is made. */
CREATE MICROFLOW FolderIntegration.REST_UploadFile (
  $Job: FolderIntegration.FolderJob,
  $Node: FolderIntegration.FolderNode
)
RETURNS FolderIntegration.RestResponse AS $Response
FOLDER 'REST placeholders'
BEGIN
  LOG INFO NODE 'FolderIntegration' 'PLACEHOLDER POST /api/v2/nodes (file {1}) returns 201' WITH ({1} = $Node/FullPath);
  $Response = CREATE FolderIntegration.RestResponse (
    Method = 'POST',
    Endpoint = '/api/v2/nodes',
    StatusCode = 201,
    IsSuccess = true,
    Message = 'File uploaded'
  );
  RETURN $Response;
END;

/** Picks the right placeholder call for a folder or a file. */
CREATE MICROFLOW FolderIntegration.SUB_CallApi (
  $Job: FolderIntegration.FolderJob,
  $Node: FolderIntegration.FolderNode
)
RETURNS FolderIntegration.RestResponse AS $Response
FOLDER 'Job'
BEGIN
  IF $Node/IsFolder THEN
    $FolderResponse = CALL MICROFLOW FolderIntegration.REST_CreateFolder (Job = $Job, Node = $Node);
    RETURN $FolderResponse;
  END IF;
  $FileResponse = CALL MICROFLOW FolderIntegration.REST_UploadFile (Job = $Job, Node = $Node);
  RETURN $FileResponse;
END;

-- ---------------------------------------------------------------------------
-- Job plumbing
-- ---------------------------------------------------------------------------

/** Plans the demo structure: 5 folders and 4 files, same tree as the HTML prototype. */
CREATE MICROFLOW FolderIntegration.SUB_SeedNodes ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  $N0 = CREATE FolderIntegration.FolderNode (Name = 'Contracts', Depth = 0, IsFolder = true, Sequence = 0, ParentSequence = -1, FullPath = 'Contracts', KindIcon = '📁', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N1 = CREATE FolderIntegration.FolderNode (Name = '2026', Depth = 1, IsFolder = true, Sequence = 1, ParentSequence = 0, FullPath = 'Contracts / 2026', KindIcon = '📁', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N2 = CREATE FolderIntegration.FolderNode (Name = 'Q3', Depth = 2, IsFolder = true, Sequence = 2, ParentSequence = 1, FullPath = 'Contracts / 2026 / Q3', KindIcon = '📁', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N3 = CREATE FolderIntegration.FolderNode (Name = 'q3-summary.pdf', Depth = 3, IsFolder = false, Sequence = 3, ParentSequence = 2, FullPath = 'Contracts / 2026 / Q3 / q3-summary.pdf', KindIcon = '📄', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N4 = CREATE FolderIntegration.FolderNode (Name = 'Q4', Depth = 2, IsFolder = true, Sequence = 4, ParentSequence = 1, SimulateFailure = true, FullPath = 'Contracts / 2026 / Q4', KindIcon = '📁', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N5 = CREATE FolderIntegration.FolderNode (Name = 'q4-summary.pdf', Depth = 3, IsFolder = false, Sequence = 5, ParentSequence = 4, FullPath = 'Contracts / 2026 / Q4 / q4-summary.pdf', KindIcon = '📄', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N6 = CREATE FolderIntegration.FolderNode (Name = 'Invoices', Depth = 1, IsFolder = true, Sequence = 6, ParentSequence = 0, FullPath = 'Contracts / Invoices', KindIcon = '📁', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N7 = CREATE FolderIntegration.FolderNode (Name = 'inv-001.pdf', Depth = 2, IsFolder = false, Sequence = 7, ParentSequence = 6, FullPath = 'Contracts / Invoices / inv-001.pdf', KindIcon = '📄', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
  $N8 = CREATE FolderIntegration.FolderNode (Name = 'inv-002.pdf', Depth = 2, IsFolder = false, Sequence = 8, ParentSequence = 6, FullPath = 'Contracts / Invoices / inv-002.pdf', KindIcon = '📄', StatusIcon = '○', FolderIntegration.FolderNode_FolderJob = $Job) COMMIT;
END;

/** Recomputes the progress and every text the pop-up and the page show, then saves the job. */
CREATE MICROFLOW FolderIntegration.SUB_RefreshDisplay ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  RETRIEVE $AllNodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job];
  RETRIEVE $DoneNodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job and (Status = 'Created' or Status = 'Reused')];
  RETRIEVE $FolderNodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job and IsFolder = true];
  $Total = COUNT $AllNodes;
  $Done = COUNT $DoneNodes;
  $Folders = COUNT $FolderNodes;
  DECLARE $Percent Integer = 0;
  IF $Total > 0 THEN
    SET $Percent = round($Done * 100 div $Total);
  END IF;
  CHANGE $Job (
    TotalCount = $Total,
    DoneCount = $Done,
    ProgressPercent = $Percent,
    StructureSummary = toString($Folders) + ' folders, ' + toString($Total - $Folders) + ' files',
    SummaryCount = toString($Done) + ' of ' + toString($Total) + ' items'
  );
  IF $Job/Status = FolderIntegration.JobStatus.Ready THEN
    CHANGE $Job (StatusChip = 'Not created', SummaryTitle = 'Planned structure', PrimaryCaption = 'Create folders', BannerKind = 'info', BannerHeadline = '', BannerText = 'Folders that already exist are reused. Nothing is overwritten.');
  ELSIF $Job/Status = FolderIntegration.JobStatus.Running THEN
    CHANGE $Job (StatusChip = 'Creating… ' + toString($Percent) + '%', SummaryTitle = 'Creating folders…', PrimaryCaption = 'View progress', BannerKind = '', BannerHeadline = '', BannerText = '');
  ELSIF $Job/Status = FolderIntegration.JobStatus.Failed THEN
    CHANGE $Job (StatusChip = 'Failed', SummaryTitle = 'Stopped', PrimaryCaption = 'View error', BannerKind = 'danger', BannerHeadline = 'Could not create ' + $Job/FailedPath + '.', BannerText = $Job/FailureReason + ' ' + toString($Done) + ' items were created before this. Retry picks up where it stopped.');
  ELSE
    CHANGE $Job (StatusChip = 'Created', SummaryTitle = 'Finished', PrimaryCaption = 'View result', BannerKind = 'success', BannerHeadline = 'Folders created.', BannerText = toString($Total) + ' items are ready in Content Server.');
  END IF;
  COMMIT $Job REFRESH;
END;

/** Throws away the old plan and plans the demo structure again. Used by Reset and when the scenario changes. */
CREATE MICROFLOW FolderIntegration.ACT_Job_Reset ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  RETRIEVE $OldNodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job];
  DELETE $OldNodes;
  CHANGE $Job (
    Status = FolderIntegration.JobStatus.Ready,
    NameChecks = 0,
    ItemsCreated = 0,
    FixedAfterRetry = false,
    FailedPath = '',
    FailureReason = ''
  );
  CALL MICROFLOW FolderIntegration.SUB_SeedNodes (Job = $Job);
  CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
END;

/** Page data source: the one demo job, created with its planned structure on first use. */
CREATE MICROFLOW FolderIntegration.DS_GetJob ()
RETURNS FolderIntegration.FolderJob AS $Result
FOLDER 'Job'
BEGIN
  RETRIEVE $Job FROM FolderIntegration.FolderJob FIRST;
  IF $Job = empty THEN
    $NewJob = CREATE FolderIntegration.FolderJob (RootFolder = 'Contracts') COMMIT;
    CALL MICROFLOW FolderIntegration.ACT_Job_Reset (Job = $NewJob);
    RETURN $NewJob;
  END IF;
  RETURN $Job;
END;

/** Saves the prototype controls (speed). */
CREATE MICROFLOW FolderIntegration.ACT_Job_SaveSettings ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  COMMIT $Job REFRESH;
END;

/** Pushes the latest committed job and node values to the open pages. */
CREATE MICROFLOW FolderIntegration.ACT_Job_Sync ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  RETRIEVE $Nodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job];
  LOOP $Node IN $Nodes BEGIN
    ROLLBACK $Node REFRESH;
  END LOOP;
  ROLLBACK $Job REFRESH;
END;
