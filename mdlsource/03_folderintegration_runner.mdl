mdl 1;

ALTER ENTITY FolderIntegration.FolderJob ADD ATTRIBUTE IF NOT EXISTS LastCheckedParent: Integer DEFAULT -2;

DROP MICROFLOW FolderIntegration.SUB_RunJob;

/**
 * The background worker. One call does one step and queues the next, so every step commits on its own
 * and the pop-up can show the progress: a step either starts the next pending item (name check, mark it
 * Working) or finishes the item that is Working (REST call, mark it Created, Already existed or Failed).
 */
CREATE MICROFLOW FolderIntegration.SUB_RunJob ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  DECLARE $Delay Integer = 350;
  IF $Job/Speed = FolderIntegration.Speed.Slow THEN
    SET $Delay = 700;
  ELSIF $Job/Speed = FolderIntegration.Speed.Fast THEN
    SET $Delay = 100;
  END IF;
  DECLARE $HalfDelay Integer = round($Delay div 2);

  RETRIEVE $Working FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job and Status = 'Checking'] SORT BY Sequence ASC FIRST;
  IF $Working != empty THEN
    -- Finish the item that is Working
    $WaitedForCall = CALL JAVA ACTION FolderIntegration.JA_SimulateLatency (Milliseconds = $Delay);
    $Response = CALL MICROFLOW FolderIntegration.SUB_CallApi (Job = $Job, Node = $Working);
    IF $Response/StatusCode = 409 THEN
      CHANGE $Working (Status = FolderIntegration.NodeStatus.Reused, StatusIcon = '↺') COMMIT;
    ELSIF $Response/IsSuccess = false THEN
      CHANGE $Working (Status = FolderIntegration.NodeStatus.Failed, StatusIcon = '✕') COMMIT;
      CHANGE $Job (Status = FolderIntegration.JobStatus.Failed, FailedPath = $Working/FullPath, FailureReason = $Response/Message);
      CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
      RETURN;
    ELSE
      CHANGE $Working (Status = FolderIntegration.NodeStatus.Created, StatusIcon = '✓') COMMIT;
      CHANGE $Job (ItemsCreated = $Job/ItemsCreated + 1);
    END IF;
    CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
    CALL MICROFLOW FolderIntegration.SUB_RunJob (Job = $Job) IN QUEUE FolderIntegration.FolderJobQueue;
    RETURN;
  END IF;

  RETRIEVE $Next FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job and Status = 'Pending'] SORT BY Sequence ASC FIRST;
  IF $Next = empty THEN
    -- Nothing left to do
    CHANGE $Job (Status = FolderIntegration.JobStatus.Done);
    CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
    RETURN;
  END IF;

  -- Start the next item: one name check per parent folder, then mark it Working
  IF $Next/ParentSequence != $Job/LastCheckedParent THEN
    $CheckResponse = CALL MICROFLOW FolderIntegration.REST_ValidateNames (Job = $Job, Node = $Next);
    CHANGE $Job (NameChecks = $Job/NameChecks + 1, LastCheckedParent = $Next/ParentSequence);
    $WaitedForCheck = CALL JAVA ACTION FolderIntegration.JA_SimulateLatency (Milliseconds = $HalfDelay);
  END IF;
  CHANGE $Next (Status = FolderIntegration.NodeStatus.Checking, StatusIcon = '…') COMMIT;
  CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
  CALL MICROFLOW FolderIntegration.SUB_RunJob (Job = $Job) IN QUEUE FolderIntegration.FolderJobQueue;
END;

/** Queues the job. From Failed, the failed item is retried and the failure does not repeat. */
CREATE OR MODIFY MICROFLOW FolderIntegration.ACT_Job_Start ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  IF $Job/Status = FolderIntegration.JobStatus.Failed THEN
    RETRIEVE $FailedNodes FROM FolderIntegration.FolderNode WHERE [FolderIntegration.FolderNode_FolderJob = $Job and Status = 'Failed'];
    LOOP $FailedNode IN $FailedNodes BEGIN
      CHANGE $FailedNode (Status = FolderIntegration.NodeStatus.Pending, StatusIcon = '○') COMMIT;
    END LOOP;
    CHANGE $Job (FixedAfterRetry = true);
  END IF;
  IF $Job/Status = FolderIntegration.JobStatus.Ready OR $Job/Status = FolderIntegration.JobStatus.Failed THEN
    CHANGE $Job (Status = FolderIntegration.JobStatus.Running, LastCheckedParent = -2);
    CALL MICROFLOW FolderIntegration.SUB_RefreshDisplay (Job = $Job);
    CALL MICROFLOW FolderIntegration.SUB_RunJob (Job = $Job) IN QUEUE FolderIntegration.FolderJobQueue;
  END IF;
END;

/** Keeps the open pages in step with a running job until it stops. */
CREATE OR MODIFY NANOFLOW FolderIntegration.NAN_WatchJob ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  WHILE $Job/Status = FolderIntegration.JobStatus.Running
  BEGIN
    $Waited = CALL JAVASCRIPT ACTION FolderIntegration.JSA_Wait (Milliseconds = 400);
    CALL MICROFLOW FolderIntegration.ACT_Job_Sync (Job = $Job);
  END WHILE;
END;

/** Starts (or retries) the job in the background and follows it. */
CREATE OR MODIFY NANOFLOW FolderIntegration.NAN_StartJob ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  CALL MICROFLOW FolderIntegration.ACT_Job_Start (Job = $Job);
  CALL NANOFLOW FolderIntegration.NAN_WatchJob (Job = $Job);
END;
