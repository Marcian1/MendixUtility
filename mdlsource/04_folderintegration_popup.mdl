mdl 1;

CREATE OR MODIFY PAGE FolderIntegration.CreateFolders_Popup (
  Params: ($Job: FolderIntegration.FolderJob),
  Title: 'Create folder structure',
  Layout: Atlas_Core.PopupLayout,
  PopupWidth: 720,
  PopupHeight: 720,
  PopupResizable: true
) {
  dataview dvJob (DataSource: $Job) {
    container ctnBanner (
      Class: 'fi-alert',
      DynamicClasses: 'fi-alert--' + $currentObject/BannerKind,
      Visible: $currentObject/BannerKind != ''
    ) {
      dynamictext txtBannerHeadline (
        Content: '{1}',
        ContentParams: ({1} = BannerHeadline),
        Class: 'fi-alert-headline',
        Visible: $currentObject/BannerHeadline != ''
      )
      dynamictext txtBannerText (Content: '{1}', ContentParams: ({1} = BannerText))
    }

    container ctnSummary (Class: 'fi-summary') {
      dynamictext txtSummaryTitle (Content: '{1}', ContentParams: ({1} = SummaryTitle), Class: 'fi-summary-title')
      dynamictext txtSummaryCount (Content: '{1}', ContentParams: ({1} = SummaryCount), Class: 'fi-summary-count')
    }

    container ctnProgress (
      Class: 'fi-progress',
      DynamicClasses: if $currentObject/Status = FolderIntegration.JobStatus.Failed then 'fi-progress--failed' else if $currentObject/Status = FolderIntegration.JobStatus.Done then 'fi-progress--done' else ''
    ) {
      pluggablewidget 'com.mendix.widget.custom.progressbar.ProgressBar' pgbProgress (
        type: expression,
        expressionCurrentValue: '$currentObject/ProgressPercent',
        expressionMinValue: '0',
        expressionMaxValue: '100',
        showLabel: false
      )
    }

    listview lvNodes (DataSource: database from $Job/FolderIntegration.FolderNode_FolderJob/FolderIntegration.FolderNode sort by Sequence asc, Class: 'fi-tree') {
      container ctnNode (
        Class: 'fi-node',
        DynamicClasses: 'fi-depth-' + toString($currentObject/Depth) + (if $currentObject/Status = FolderIntegration.NodeStatus.Failed then ' fi-node--failed' else '')
      ) {
        dynamictext txtStatusIcon (
          Content: '{1}',
          ContentParams: ({1} = StatusIcon),
          Class: 'fi-status-icon',
          DynamicClasses: if $currentObject/Status = FolderIntegration.NodeStatus.Checking then 'is-checking' else if $currentObject/Status = FolderIntegration.NodeStatus.Created then 'is-created' else if $currentObject/Status = FolderIntegration.NodeStatus.Reused then 'is-reused' else if $currentObject/Status = FolderIntegration.NodeStatus.Failed then 'is-failed' else 'is-pending'
        )
        dynamictext txtKindIcon (Content: '{1}', ContentParams: ({1} = KindIcon), Class: 'fi-kind-icon')
        dynamictext txtNodeName (Content: '{1}', ContentParams: ({1} = Name), Class: 'fi-node-name')
        dynamictext txtNodeStatus (
          Content: '{1}',
          ContentParams: ({1} = Status),
          Class: 'fi-label',
          DynamicClasses: if $currentObject/Status = FolderIntegration.NodeStatus.Checking then 'is-checking' else if $currentObject/Status = FolderIntegration.NodeStatus.Created then 'is-created' else if $currentObject/Status = FolderIntegration.NodeStatus.Reused then 'is-reused' else if $currentObject/Status = FolderIntegration.NodeStatus.Failed then 'is-failed' else 'is-pending',
          Visible: $currentObject/Status != FolderIntegration.NodeStatus.Pending
        )
      }
    }

    container ctnStats (Class: 'fi-stats') {
      dynamictext txtNameChecks (Content: 'Name checks: {1}', ContentParams: ({1} = NameChecks))
      dynamictext txtItemsCreated (Content: 'Items created: {1}', ContentParams: ({1} = ItemsCreated))
    }

    container ctnFooter (Class: 'fi-footer') {
      dynamictext txtRunningHint (
        Content: 'Runs in the background. You can close this window.',
        Class: 'fi-footer-hint',
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Running
      )
      actionbutton btnCancel (
        Caption: 'Cancel',
        Action: close page,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Ready
      )
      actionbutton btnCreate (
        Caption: 'Create folders',
        Action: call nanoflow FolderIntegration.NAN_StartJob(Job = $currentObject),
        ButtonStyle: primary,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Ready
      )
      actionbutton btnCloseRunning (
        Caption: 'Close',
        Action: close page,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Running
      )
      actionbutton btnCloseFailed (
        Caption: 'Close',
        Action: close page,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Failed
      )
      actionbutton btnRetry (
        Caption: 'Retry',
        Action: call nanoflow FolderIntegration.NAN_StartJob(Job = $currentObject),
        ButtonStyle: primary,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Failed
      )
      actionbutton btnCloseDone (
        Caption: 'Close',
        Action: close page,
        ButtonStyle: primary,
        Visible: $currentObject/Status = FolderIntegration.JobStatus.Done
      )
    }
  }
};

/** Opens the pop-up. A job that is still running is followed again. */
CREATE OR MODIFY NANOFLOW FolderIntegration.NAN_OpenPopup ($Job: FolderIntegration.FolderJob)
FOLDER 'Job'
BEGIN
  SHOW PAGE FolderIntegration.CreateFolders_Popup (Job = $Job);
  CALL NANOFLOW FolderIntegration.NAN_WatchJob (Job = $Job);
END;
